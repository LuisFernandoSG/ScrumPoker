{
  "name": "pokerscrum",
  "version": "1.0.0",
  "description": "Aplicación de Planning Poker en tiempo real con React, Tailwind CSS, Node.js y Socket.IO",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgCyan.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
